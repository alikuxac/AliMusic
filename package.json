{
  "name": "@aliuxac/music",
  "version": "1.2.0",
  "description": "Alikuxac Personal Music Discord Bot",
  "main": "dist/index.js",
  "imports": {
    "#lib/*": "./dist/lib/*.js",
    "#lib/structures/*": "./dist/lib/structures/*.js",
    "#config": "./dist/config/*.js",
    "#root/*": "./dist/*.js",
    "#models/*": "./dist/models/*.js",
    "#utils/*": "./dist/utils/*.js",
    "#decorators/*": "./dist/decorators/*.js",
    "#constants/*": "./dist/constants/*.js"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "tsc -b src",
    "compile": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "pm2": "pm2 start npm --name AliMusic -- start --watch",
    "pm2:npx": "npx pm2 start npm --name AliMusic -- start --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alikuxac/AliMusic.git"
  },
  "keywords": [
    "discord",
    "alikuxac"
  ],
  "author": "Alikuxac",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alikuxac/AliMusic/issues"
  },
  "homepage": "https://github.com/alikuxac/AliMusic#readme",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "@distube/soundcloud": "^2.0.4",
    "@distube/spotify": "^2.0.2",
    "@distube/yt-dlp": "^2.0.1",
    "@sapphire/decorators": "^6.1.1",
    "@sapphire/discord-utilities": "^3.4.4",
    "@sapphire/discord.js-utilities": "^7.3.2",
    "@sapphire/framework": "^5.3.3",
    "@sapphire/pieces": "^4.3.2",
    "axios": "^1.8.4",
    "colorette": "^2.0.20",
    "discord.js": "^14.18.0",
    "distube": "^5.0.7",
    "dotenv": "^16.5.0",
    "libsodium-wrappers": "^0.7.15",
    "lodash": "^4.17.21",
    "mongoose": "^8.13.2",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@types/lodash": "4.17.16",
    "@types/node": "22.14.1",
    "node-abort-controller": "3.1.1",
    "rimraf": "6.0.1",
    "typescript": "5.8.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
